# Copy to .env and fill in with your own generated keys.
# NEVER commit .env or share its contents.
# Keys must be at least 24 characters.
SIGNALFORGE_DB_PATH=./data/signalforge.db
SIGNALFORGE_READ_KEYS=
SIGNALFORGE_ADMIN_KEYS=
SIGNALFORGE_RATE_LIMIT_PER_MINUTE=60
SIGNALFORGE_STALE_AFTER_SECONDS=300
# Optional: approved Pump.fun Developer API key (content.read scope); server-side only.
PUMPFUN_API_KEY=

# Optional private Telegram notifications; keep both values server-side only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Solana public-wallet parsed transaction history.
HELIUS_API_KEY=
