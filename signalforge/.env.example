# Copy to .env and fill in with your own generated keys.
# NEVER commit .env or share its contents.
# Keys must be at least 24 characters.
SIGNALFORGE_DB_PATH=./data/signalforge.db
SIGNALFORGE_READ_KEYS=REPLACE_WITH_YOUR_OWN_READ_KEY
SIGNALFORGE_ADMIN_KEYS=REPLACE_WITH_YOUR_OWN_ADMIN_KEY
SIGNALFORGE_RATE_LIMIT_PER_MINUTE=60
SIGNALFORGE_STALE_AFTER_SECONDS=300
