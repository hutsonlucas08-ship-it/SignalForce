{
  "manifest_version": 3,
  "name": "SignalForce FOMO Copilot Bridge",
  "version": "0.1.0",
  "description": "Local read-only bridge from your signed-in FOMO browser session to your SignalForce customer workspace.",
  "permissions": ["storage", "alarms", "tabs", "webRequest"],
  "host_permissions": [
    "https://fomo.family/*",
    "https://*.fomo.family/*",
    "https://prod-api.fomo.family/*",
    "https://signalforce-qwat.onrender.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://signalforce-qwat.onrender.com/*"],
      "js": ["signalforce_content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SignalForce FOMO Copilot"
  }
}
